#. Plugin Name of the plugin
#: montecchiani-book-catalog.php
msgid "Montecchiani Book Catalog"
msgstr "Montecchiani Book Catalog"

#. Description of the plugin
#: montecchiani-book-catalog.php
msgid "Book catalog with a Book post type, genres, a responsive shortcode grid and one-click ISBN autofill from Google Books and Open Library."
msgstr "Catalogue de livres avec un type de publication Livre, des genres, une grille responsive via code court et le remplissage automatique en un clic depuis l’ISBN avec Google Books et Open Library."

#. Author of the plugin
#: montecchiani-book-catalog.php
msgid "Mirko Montecchiani"
msgstr "Mirko Montecchiani"

#. Author URI of the plugin
