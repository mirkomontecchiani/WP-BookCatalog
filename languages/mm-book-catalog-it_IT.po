#. Plugin Name of the plugin
#: mm-book-catalog.php
msgid "MM Book Catalog"
msgstr ""

#. Plugin URI of the plugin
#: mm-book-catalog.php
msgid "https://github.com/mirkomontecchiani/WP-BookCatalog"
msgstr ""

#. Description of the plugin
#: mm-book-catalog.php
msgid "Book catalog with a Book post type, genres, a responsive shortcode grid and one-click ISBN autofill from Google Books and Open Library."
msgstr "Catalogo di libri con un tipo di contenuto Libro, generi, una griglia shortcode responsive e la compilazione automatica da ISBN con un clic tramite Google Books e Open Library."

#. Author of the plugin
#: mm-book-catalog.php
msgid "Mirko Montecchiani"
msgstr ""

