#. Plugin Name of the plugin
#: mm-book-catalog.php
msgid "MM Book Catalog"
msgstr ""

#. Plugin URI of the plugin
#: mm-book-catalog.php
msgid "https://github.com/mirkomontecchiani/WP-BookCatalog"
msgstr ""

#. Description of the plugin
#: mm-book-catalog.php
msgid "Book catalog with a Book post type, genres, a responsive shortcode grid and one-click ISBN autofill from Google Books and Open Library."
msgstr "Catálogo de libros con un tipo de contenido Libro, géneros, una cuadrícula responsive mediante shortcode y autorrelleno del ISBN con un solo clic desde Google Books y Open Library."

#. Author of the plugin
#: mm-book-catalog.php
msgid "Mirko Montecchiani"
msgstr ""

